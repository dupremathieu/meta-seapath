#!/bin/sh
# SPDX-License-Identifier: Apache-2.0
# SEAPATH initramfs init script

log() { echo "initramfs: $*" > /dev/console 2>&1; }

log "starting"

mount -t proc proc /proc
log "proc mounted"

mount -t sysfs sysfs /sys
log "sysfs mounted"

mount -t devtmpfs devtmpfs /dev 2>/dev/null || log "devtmpfs mount failed (may be built-in)"

# Parse root= from kernel command line
ROOTSPEC=""
for arg in $(cat /proc/cmdline); do
    case "$arg" in
        root=*) ROOTSPEC="${arg#root=}" ;;
    esac
done
log "root spec = $ROOTSPEC"

# Resolve root device
if [ -n "$ROOTSPEC" ]; then
    ROOTDEV=""
    case "$ROOTSPEC" in
        LABEL=*)
            LABEL="${ROOTSPEC#LABEL=}"
            log "looking for LABEL=$LABEL"
            ROOTDEV=$(findfs LABEL="$LABEL" 2>/dev/null)
            ;;
        PARTUUID=*)
            UUID="${ROOTSPEC#PARTUUID=}"
            log "looking for PARTUUID=$UUID"
            ROOTDEV=$(findfs PARTUUID="$UUID" 2>/dev/null)
            ;;
        /dev/*)
            ROOTDEV="$ROOTSPEC"
            ;;
    esac
    log "root device = $ROOTDEV"
fi

# Fallback
if [ -z "$ROOTDEV" ]; then
    log "trying fallback LABEL=rootfs0"
    sleep 3
    ROOTDEV=$(findfs LABEL=rootfs0 2>/dev/null)
    log "fallback = $ROOTDEV"
fi

if [ -z "$ROOTDEV" ]; then
    log "ERROR: no root device found"
    blkid 2>/dev/null
    exec /bin/sh
fi

log "mounting rootfs $ROOTDEV"
mkdir -p /mnt/root
mount -t ext4 -o ro "$ROOTDEV" /mnt/root || {
    log "ro mount failed, trying rw..."
    mount -t ext4 "$ROOTDEV" /mnt/root || {
        log "FATAL: cannot mount rootfs"
        exec /bin/sh
    }
}

log "rootfs mounted, setting up overlay..."

# Setup persistent overlay
if blkid -L persistent >/dev/null 2>&1; then
    PERSISTENT=$(blkid -L persistent)
    log "persistent=$PERSISTENT"
    mkdir -p /mnt/root/mnt/persistent
    mount -t ext4 "$PERSISTENT" /mnt/root/mnt/persistent 2>/dev/null
    if mountpoint -q /mnt/root/mnt/persistent 2>/dev/null; then
        mount --make-rshared /mnt/root
        mount --make-rshared /mnt/root/mnt/persistent
        mkdir -p /mnt/root/mnt/persistent/etc
        mkdir -p /mnt/root/mnt/persistent/.etc-work
        mkdir -p /mnt/root/mnt/persistent/var
        mount -t overlay overlay \
            -o lowerdir=/mnt/root/etc,upperdir=/mnt/root/mnt/persistent/etc,workdir=/mnt/root/mnt/persistent/.etc-work \
            /mnt/root/etc 2>/dev/null
        log "overlay setup done"
    else
        log "persistent mount failed"
    fi
fi

log "switching to real rootfs"
exec switch_root /mnt/root /sbin/init
log "switch_root failed!"
exec /bin/sh
